# ============================================================
#  正式環境（npm run build 預設就是讀這個檔）
#
#  ⚠ 一律用「相對路徑」，不要寫絕對 URL。
#
#  正式站的前端和 API 掛在同一個網域下（Caddy → 前端 nginx → api-gateway），
#  是同源的，所以 /api 和 /ws 就夠了，也不會有 CORS 問題。
#
#  這裡原本寫的是 http://YOUR_SERVER_IP/api ——範本佔位字串從來沒被替換，
#  build 出來的 bundle 就真的去打 "YOUR_SERVER_IP" 這個不存在的主機，
#  登入必然失敗。而用 curl 直接打正確網址會回 200，所以很難察覺是前端的問題。
# ============================================================

VITE_API_URL=/api
VITE_WS_URL=/ws

# reCAPTCHA site key（site key 是公開的，要保密的是 secret）——註冊 / 忘記密碼頁會用到
VITE_RECAPTCHA_SITE_KEY=6Lci9EMtAAAAANkulzDVKX4VPwFxTXxtA1CjMZii

# 第三方登入（GitHub / Google / Azure）
# 後端 auth-service 要同時啟用 `oauth` profile 並填好 client id/secret，
# 這裡才能設 true——否則登入頁會出現按了會 404 的按鈕。
VITE_OAUTH_ENABLED=false

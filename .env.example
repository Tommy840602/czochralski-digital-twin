# ============================================================
#  長晶爐數位孿生 — 環境變數範本
#  複製為 .env 並填入實際值
# ============================================================

# ── MQTT ──
MQTT_HOST=localhost
MQTT_PORT=1883

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ── TimescaleDB ──
TIMESCALE_URL=jdbc:postgresql://localhost:5432/furnace_db
TIMESCALE_USER=twin
TIMESCALE_PASSWORD=twin_secret

# ── MongoDB ──
MONGO_URI=mongodb://twin:twin_secret@localhost:27017/twin_db?authSource=admin

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Elasticsearch ──
ES_HOST=localhost
ES_PORT=9200

# ── Slack ──
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WEBHOOK_URL
SLACK_CHANNEL=#furnace-alerts

# ── Spring Boot ──
SPRING_PROFILES_ACTIVE=development
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ── Grafana ──
GRAFANA_ADMIN_PASSWORD=twin_admin

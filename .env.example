# ============================================================
#  長晶爐數位孿生 — 環境變數範本
#  複製為 .env 並填入實際值：cp .env.example .env
# ============================================================

# ── MQTT ──
MQTT_HOST=localhost
MQTT_PORT=1883

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ── TimescaleDB (時序資料 + auth) ──
TIMESCALE_URL=jdbc:postgresql://localhost:5432/furnace_db
TIMESCALE_USER=twin
TIMESCALE_PASSWORD=twin_secret

# ── MongoDB ──
MONGO_URI=mongodb://twin:twin_secret@localhost:27017/twin_db?authSource=admin

# ── Redis (快取 + SMS 冷卻 + 密碼重設 token) ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Elasticsearch ──
ES_HOST=localhost
ES_PORT=9200

# ── Slack ──
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WEBHOOK_URL
SLACK_CHANNEL=#furnace-alerts

# ── Spring Boot / Eureka ──
SPRING_PROFILES_ACTIVE=development
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ── Grafana ──
GRAFANA_ADMIN_PASSWORD=twin_admin

# ── LLM (OpenAI, 用於 AI 報告) ──
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================
#  認證系統
# ============================================================

# ── JWT (auth-service 簽發, gateway 驗簽; 必須 >= 32 bytes) ──
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long

# ── reCAPTCHA v2 (註冊防機器人; 空值 = 略過驗證，適合 dev) ──
RECAPTCHA_SECRET=

# ── SMS (Twilio; SMS_PROVIDER=log 時只印 log 不真發簡訊) ──
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Email (SMTP 忘記密碼寄信; EMAIL_PROVIDER=log 時只印 log 不真寄信) ──
EMAIL_PROVIDER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── OAuth2 GitHub ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OAuth2 Google ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth2 Azure/Microsoft (Outlook) ──
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common

# ── Slack ──
SLACK_WEBHOOK_URL=
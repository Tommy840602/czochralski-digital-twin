# ============================================================
#  生產環境設定範本  →  複製成 .env.prod 後填入真值
#
#      cp .env.prod.example .env.prod && chmod 600 .env.prod
#
#  ⚠ 每個密碼都必須自己產生。不要沿用開發用的 twin_secret / twin_admin——
#     這台機器有公網 IP，弱密碼等於沒有密碼。
#     compose 對必填項用了 ${VAR:?} 語法：沒填就直接啟動失敗，杜絕誤用預設值上線。
#
#  一鍵產生所有隨機密碼（貼到終端機執行，把輸出填到下面）：
#    for k in POSTGRES_PASSWORD MONGO_PASSWORD REDIS_PASSWORD GRAFANA_ADMIN_PASSWORD JWT_SECRET; do
#      echo "$k=$(openssl rand -base64 36 | tr -dc 'A-Za-z0-9' | head -c 40)"
#    done
# ============================================================

# ── 網域與 TLS ──────────────────────────────────────────────
DOMAIN=tommy-huang.dev
ACME_EMAIL=                       # Let's Encrypt 憑證到期通知信箱（必填）

# ── 管理介面 basic auth（Kibana / Kafka UI / Flink UI / Prometheus）──
ADMIN_USER=admin
# bcrypt hash。用這行產生，把輸出整串貼進來：
#   docker run --rm caddy caddy hash-password --plaintext '你的密碼'
ADMIN_PASSWORD_HASH=

# ── 資料庫（Timescale / Mongo / Redis）─────────────────────
POSTGRES_USER=twin
POSTGRES_PASSWORD=
MONGO_USER=twin
MONGO_PASSWORD=
REDIS_PASSWORD=

# ── Grafana（有自己的登入頁，帳號沿用 ADMIN_USER）──────────
GRAFANA_ADMIN_PASSWORD=

# ── 應用 ────────────────────────────────────────────────────
JWT_SECRET=                       # 至少 32 bytes，否則簽章強度不足

# Slack 告警（SPC Rule 1 / ±3σ CRITICAL 時觸發）
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#furnace-alerts

# ── 選用（沒用到就留空）─────────────────────────────────────
ELASTIC_PASSWORD=                 # ES 的 xpack.security 目前是關的，這欄位沒作用
OPENAI_API_KEY=
RECAPTCHA_SECRET=

# OAuth 第三方登入
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common

# 簡訊 / 郵件（預設 log，不實際發送）
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMAIL_PROVIDER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

{
  "title": "長晶爐數位孿生 — 爐況監控",
  "uid": "czochralski-furnace-v2",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "timezone": "Asia/Taipei",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "czochralski",
    "furnace"
  ],
  "templating": {
    "list": [
      {
        "name": "furnace",
        "type": "query",
        "label": "爐子",
        "datasource": {
          "type": "postgres",
          "uid": "DS_TIMESCALEDB"
        },
        "query": "SELECT furnace_id FROM furnace_registry ORDER BY furnace_id",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "爐況總覽",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "活躍爐子數",
      "datasource": {
        "type": "postgres",
        "uid": "DS_TIMESCALEDB"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(DISTINCT furnace_id) AS \"活躍爐子\" FROM furnace_metrics WHERE $__timeFilter(time)",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "平均爐溫",
      "datasource": {
        "type": "postgres",
        "uid": "DS_TIMESCALEDB"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "orange",
                "value": 1200
              },
              {
                "color": "red",
                "value": 1400
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT $__timeGroupAlias(time,$__interval), AVG(heater_temp) AS \"爐溫\" FROM furnace_metrics WHERE $__timeFilter(time) AND furnace_id IN ($furnace) AND heater_temp > 0 GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "平均直徑",
      "datasource": {
        "type": "postgres",
        "uid": "DS_TIMESCALEDB"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mm",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT $__timeGroupAlias(time,$__interval), AVG(diameter) AS \"直徑\" FROM furnace_metrics WHERE $__timeFilter(time) AND furnace_id IN ($furnace) AND diameter > 0 GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "運行模式分佈",
      "datasource": {
        "type": "postgres",
        "uid": "DS_TIMESCALEDB"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT operation_mode AS \"模式\", COUNT(*) AS \"筆數\" FROM furnace_metrics WHERE $__timeFilter(time) AND furnace_id IN ($furnace) AND operation_mode IS NOT NULL GROUP BY operation_mode ORDER BY 2 DESC LIMIT 10",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "爐溫趨勢",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Heater Temperature",
      "datasource": {
        "type": "postgres",
        "uid": "DS_TIMESCALEDB"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "min",
            "max",
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT time, furnace_id AS metric, AVG(heater_temp) AS \"爐溫\" FROM furnace_metrics WHERE $__timeFilter(time) AND furnace_id IN ($furnace) AND heater_temp > 0 GROUP BY time,furnace_id ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "直徑趨勢",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Diameter (mm)",
      "datasource": {
        "type": "postgres",
        "uid": "DS_TIMESCALEDB"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mm",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT time, furnace_id AS metric, AVG(diameter) AS \"直徑\" FROM furnace_metrics WHERE $__timeFilter(time) AND furnace_id IN ($furnace) AND diameter > 0 GROUP BY time,furnace_id ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "生長速率",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "GR Mean (mm/min)",
      "datasource": {
        "type": "postgres",
        "uid": "DS_TIMESCALEDB"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mm/min",
          "decimals": 3,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT time, furnace_id AS metric, AVG(gr_mean) AS \"GR Mean\" FROM furnace_metrics WHERE $__timeFilter(time) AND furnace_id IN ($furnace) GROUP BY time,furnace_id ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Body Length (mm)",
      "datasource": {
        "type": "postgres",
        "uid": "DS_TIMESCALEDB"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mm",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 6,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT time, furnace_id AS metric, AVG(body_length) AS \"晶棒長度\" FROM furnace_metrics WHERE $__timeFilter(time) AND furnace_id IN ($furnace) AND body_length > 0 GROUP BY time,furnace_id ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 50,
      "type": "row",
      "title": "爐況總表",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 51,
      "type": "table",
      "title": "最新爐況一覽",
      "datasource": {
        "type": "postgres",
        "uid": "DS_TIMESCALEDB"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "options": {
        "sortBy": [
          {
            "displayName": "furnace_id",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT furnace_id, display_name, status, ingot_no, operation_mode, ROUND(diameter::numeric,2) AS diameter, ROUND(heater_temp::numeric,1) AS heater_temp, ROUND(gr_mean::numeric,3) AS gr_mean, ROUND(body_length::numeric,1) AS body_length, last_log_time FROM furnace_latest ORDER BY furnace_id",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ]
}